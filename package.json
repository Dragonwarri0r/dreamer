{
  "name": "dreamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx apps/host/main.ts",
    "start": "node --import tsx apps/host/main.ts",
    "build": "vite build --config apps/studio/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-boundaries.mjs",
    "check:01": "npm run typecheck && node --import tsx --test tests/01-*.test.ts",
    "check:02": "npm run typecheck && node --import tsx --test tests/02-*.test.ts && npm run build",
    "check:03": "npm run typecheck && node --import tsx --test tests/03-*.test.ts",
    "check:04": "npm run typecheck && node --import tsx --test tests/04-*.test.ts",
    "check:05": "npm run typecheck && node --import tsx --test tests/05-*.test.ts",
    "check:06": "npm run typecheck && node --import tsx --test tests/06-*.test.ts",
    "check:07": "npm run typecheck && node --import tsx --test tests/07-*.test.ts",
    "check:08": "npm run typecheck && node --import tsx --test tests/08-*.test.ts",
    "schemas": "node --import tsx scripts/export-schemas.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "video:worker": "node --import tsx scripts/video-worker.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "test:journey": "node --import tsx scripts/browser-journey.ts",
    "test:agent": "node --import tsx scripts/agent-smoke.ts",
    "test:provider": "node --import tsx scripts/provider-smoke.ts",
    "test:creative": "node --import tsx scripts/creative-acceptance.ts",
    "h3:verify": "node --import tsx scripts/h3-worker.ts --verify",
    "h3:worker": "node --import tsx scripts/h3-worker.ts",
    "test:h3": "node --import tsx scripts/h3-smoke.ts",
    "test:video-worker": "PYTHONDONTWRITEBYTECODE=1 ../short-dreamer/.local/video-venv/bin/python -m unittest discover -s workers/tests -p \"test_*.py\"",
    "test:longform": "node --import tsx scripts/browser-longform.ts",
    "test:preview": "node --import tsx scripts/browser-preview.ts",
    "test:agent-ui": "node --import tsx scripts/browser-agent-audit.ts",
    "test:responsive": "node --import tsx scripts/browser-responsive.ts",
    "test:journey-audit": "node --import tsx scripts/browser-journey-audit.ts",
    "test:context": "node --import tsx scripts/browser-context-audit.ts",
    "test:agent-real": "node --import tsx scripts/browser-agent-real.ts",
    "test:production-input": "node --import tsx scripts/browser-production-input.ts",
    "check:09": "npm run typecheck && node --import tsx --test tests/11-*.test.ts && npm run build",
    "test:interactive-script": "node --import tsx scripts/browser-interactive-script.ts",
    "test:interactive-playback": "node --import tsx scripts/browser-interactive-playback.ts",
    "test:interactive-archive": "node --import tsx scripts/browser-interactive-archive.ts",
    "test:interactive-adoption": "node --import tsx scripts/browser-interactive-adoption.ts",
    "test:consumer": "node --import tsx scripts/browser-consumer-journey.ts",
    "test:consumer-recovery": "node --import tsx scripts/browser-consumer-playback-recovery.ts",
    "test:consumer-library": "node --import tsx scripts/browser-consumer-library.ts",
    "test:consumer-ux-state": "node --import tsx scripts/browser-consumer-ux-state.ts",
    "test:ux-layout": "node --import tsx scripts/browser-ux-layout.ts",
    "test:author-ux": "node --import tsx scripts/browser-author-ux-fixes.ts",
    "test:consumer-ui": "node --import tsx scripts/browser-ui-organization.ts",
    "test:author-ui": "node --import tsx scripts/browser-author-organization.ts",
    "demo": "npm run build && node --import tsx scripts/demo.ts",
    "demo:media": "npm run demo -- --media",
    "source:check": "node scripts/public-source.mjs",
    "source:export": "node scripts/public-source.mjs --output",
    "start:local": "node --env-file=.env.local --import tsx apps/host/main.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragonwarri0r/dreamer.git"
  },
  "bugs": {
    "url": "https://github.com/Dragonwarri0r/dreamer/issues"
  }
}
