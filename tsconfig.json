{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["apps", "packages", "scripts", "tests"], "exclude": ["node_modules", "dist", "data", ".local"]
}
