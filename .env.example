# Copy to .env.local, then run: npm run build && npm run start:local
# npm start does NOT automatically load dotenv files.
DREAMER_DATA_ROOT=data/workspace
DREAMER_PORT=4327
DREAMER_RUNTIME_TEXT=disabled

# Optional local text server; use the actual model ID from your own server.
# DREAMER_RUNTIME_TEXT=local
# DREAMER_RUNTIME_TEXT_URL=http://127.0.0.1:1234/v1
# DREAMER_RUNTIME_TEXT_MODEL=your-local-model

# Optional existing executables. Never paste login credentials here.
# DREAMER_CODEX_BIN=/absolute/path/to/codex
# DREAMER_FFMPEG=/absolute/path/to/ffmpeg
# DREAMER_FFPROBE=/absolute/path/to/ffprobe

# Cloud video keys are entered in the local UI, stored under
# DREAMER_DATA_ROOT/credentials/video-providers.json, and excluded from source.
# Demo ignores DREAMER_DATA_ROOT and does not load this file.
